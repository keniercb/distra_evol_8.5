        </obtenerConfiguracionAvisos>

        <!-- Servicio para obtener la denominacion de los avisos -->
        <obtenerDenominacionAvisos>
            <inyector clase="NotificationService" metodo="obtenerDenominacionAvisos" />
            <prototipo>
                <parametro nombre="page" tipo="enterospos" />
                <resultado tipo="array" />
            </prototipo>
        </obtenerDenominacionAvisos>
