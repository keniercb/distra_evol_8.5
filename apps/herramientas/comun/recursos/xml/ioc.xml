        <activarDesactivarAviso>
            <inyector clase="NotificationService" metodo="activarDesactivarAviso" />
            <prototipo>
                <parametro nombre="idaviso" tipo="enterospos" />
            </prototipo>
        </activarDesactivarAviso>
		<!-- Servicio que permite eliminar un aviso. -->
        <eliminarAviso>
            <inyector clase="NotificationService" metodo="eliminarAviso" />
            <prototipo>
                <parametro nombre="nombreEvento" tipo="string" />
                <parametro nombre="idaviso" tipo="enterospos" />
            </prototipo>
        </eliminarAviso>
		<!-- Servicio para modificar los contenidos de los avisos por la vías especificadas. -->
        <modificarContenidosAviso>
            <inyector clase="NotificationService" metodo="modificarContenidosAviso" />
            <prototipo>
                <parametro nombre="idaviso" tipo="enterospos" />
                <parametro nombre="attributes" tipo="array" />
                <parametro nombre="spec" tipo="array" />
            </prototipo>
        </modificarContenidosAviso>

