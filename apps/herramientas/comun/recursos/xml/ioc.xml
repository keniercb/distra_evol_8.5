                <parametro nombre="idPersonas" tipo="array" />
                <parametro nombre="content" tipo="string" />
                <parametro nombre="tipoAviso" tipo="enteropos" />
                <parametro nombre="cmd" tipo="string" />
                <parametro nombre="fecha" tipo="string" />
                <parametro nombre="arguments" tipo="array" />
                <resultado tipo="bool" />
            </prototipo>
        </sendSistemNotifiTime>

		<!-- Servicio que devuelve la información de un aviso dado su creador. -->
        <obtenerInfoAvisoDadoCreador>
            <inyector clase="NotificationService" metodo="obtenerInfoAvisoDadoCreador" />
            <prototipo>
                <parametro nombre="idusuario" tipo="enterospos" />
                <resultado tipo="array" />
            </prototipo>
        </obtenerInfoAvisoDadoCreador>
        <cambiarEstadoNotificacion>
            <inyector clase="NotificationService" metodo="cambiarEstadoNotificacion" />
            <prototipo>
