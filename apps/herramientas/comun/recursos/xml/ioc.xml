                <parametro nombre="idestado" />
                <resultado tipo="array" />
            </prototipo>
        </obtenerEstado>
        <BuscarConfTipoDoc reference="">
            <inyector clase="FlujoTrabajoService" metodo="BuscarConfTipoDoc" />
            <prototipo>
                <parametro nombre="uri" />
