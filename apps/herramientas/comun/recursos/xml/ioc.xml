        </sendJabberNotification>
        <sendSistemMessage reference="">
            <inyector clase="NotificationService" metodo="sendSistemMessage" />
            <prototipo>
                <parametro nombre="idPersonas" tipo="array" />
                <parametro nombre="content" tipo="string" />
                <parametro nombre="tipoAviso" tipo="enteropos" />
