			reference="">
            <inyector clase="NotificationService" metodo="obtenerScriptsVentanaEditarAviso" />
            <prototipo>

                <resultado tipo="array" />
            </prototipo>
        </obtenerScriptsVentanaEditarAviso>
        <sendEmail reference="">
            <inyector clase="NotificationService" metodo="sendEmail" />
            <prototipo>
                <parametro nombre="emails" tipo="array" />
                <parametro nombre="subject" tipo="string" />
                <parametro nombre="content" tipo="string" />
                <resultado tipo="bool" />
            </prototipo>
        </sendEmail>

        <sendPHPEmail reference="">
            <inyector clase="NotificationService" metodo="sendPHPEmail" />
            <prototipo>
                <parametro nombre="emails" tipo="array" />
                <parametro nombre="subject" tipo="string" />
                <parametro nombre="content" tipo="string" />
                <resultado tipo="bool" />
            </prototipo>
        </sendPHPEmail>
        <sendJabberNotification reference="">
            <inyector clase="NotificationService" metodo="sendJabberNotification" />
            <prototipo>
                <parametro nombre="to" tipo="array" />
