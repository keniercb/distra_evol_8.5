                <resultado tipo="bool" />
            </prototipo>
        </cambiarEstadoNotificacion>
        <eliminarNotificacion>
            <inyector clase="NotificationService" metodo="eliminarNotificacion" />
            <prototipo>
                <parametro nombre="id" tipo="array" />
                <resultado tipo="bool" />
            </prototipo>
        </eliminarNotificacion>
	    <obtenerNotificaciones>
            <inyector clase="NotificationService" metodo="obtenerNotificaciones" />
            <prototipo>
                <parametro nombre="idusuario" tipo="string" />
                <parametro nombre="typeAviso" tipo="enterospos" default='0'/>
                <resultado tipo="array" />
            </prototipo>
        </obtenerNotificaciones>
        <obtenerCantidadNotificaciones>
            <inyector clase="NotificationService" metodo="obtenerCantidadNotificaciones" />
            <prototipo>
