<?xml version="1.0" encoding="UTF-8"?>
<expressions>
    <enterospos>/^[0-9]+$/</enterospos>
    <numerosguionbajo>/^[0-9]+(_[0-9]+)*$/</numerosguionbajo>
    <letras>/^([a-zA-ZáéíóúñüÑ]+ ?[a-zA-ZáéíóúñüÑ]*)+$/</letras>
    <letrasguion>/^([a-zA-ZáéíóúñüÑ]+ ?[a-zA-ZáéíóúñüÑ\_]*)+$/</letrasguion>
    <numerosletras>/^([a-zA-Z0-9áéíóúñüÑ]+ ?[a-zA-Z0-9áéíóúñüÑ]*)+$/</numerosletras>
    <numerosletrasguion>/^([a-zA-Z0-9áéíóúñüÑ]+ ?[a-zA-Z0-9áéíóúñüÑ\_]*)+$/</numerosletrasguion>
    <email>/^[^@ ]+@[^@ ]+.[^@ .]+$/</email>
    <real>/^-?^[0-9]+(.?[0-9]*)?$/</real>
    <ireal>/^-?[0-9]+(\.[0-9]*)?$/</ireal>
    <fecha>/([0-9]{1,2})/([0-9]{1,2})/([0-9]{4})/</fecha>
    <fechacont>/([0-9]{4})-([0-9]{1,2})-([0-9]{1,2})/</fechacont>
    <fechacontr>/([0-9]{1,2})-([0-9]{1,2})-([0-9]{4})/</fechacontr>
    <vtletrascomasptocoma>/^([a-zA-ZáéíóúñÑ]+ ?[a-zA-ZáéíóúñÑ\,\;]*)+$/</vtletrascomasptocoma>
    <vtalfanumericosguiones>/(^([a-zA-ZáéíóúÁÉÍÓÚñÑ])+([a-zA-ZáéíóúÁÉÍÓÚñÑ\d\_\s\-]*))$/</vtalfanumericosguiones>
    <alfanumguionesptoarroba>/(^([a-zA-ZáéíóúñÑ])+([a-zA-ZáéíóúñÑ\d\_\s\-\@\.]*))$/</alfanumguionesptoarroba>
    <alfanumguionesptoslashes>/(^([a-zA-ZáéíóúñÑ\/])+([a-zA-ZáéíóúñÑ\d\_\s\-\.\/]*))$/</alfanumguionesptoslashes>
    <letrasguion>/^([a-zA-ZáéíóúÁÉÍÓÚñÑ ]+ ?[a-zA-ZáéíóúÁÉÍÓÚñÑ\_]*)+$/</letrasguion>
    <alfanumguionesptodosptocoma>/^([a-zA-ZáéíóúñÑ\d\/])+([a-zA-ZáéíóúñÑ\d\_\s\-\,\:\;\.\/]*)$/</alfanumguionesptodosptocoma>
    <alfanumguionesptoarrobaparentesisampersan>/(^([a-zA-ZáéíóúñÑ])+([a-zA-ZáéíóúñÑ\d\_\s\-\@\.\/\(\)\&amp;]*))$/</alfanumguionesptoarrobaparentesisampersan>
    <correo>/^[\w-\.]+@([\w-]+\.)+[\w-]{2,4}$/</correo>
    <expresion>/^(\/{1}).+(\/{1})$/</expresion>
    <ip>/^([1-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])(\.([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5])){2}(\.([0-9]|[1-9][0-9]|1[0-9][0-9]|2[0-4][0-9]|25[0-5]))$/</ip>
    <boolean>/^(true)|(TRUE)|(false)|(FALSE)$/</boolean>
    <todoMenosEspacios>/^[^ \t\n\x0B\f\r]+$/</todoMenosEspacios>
    <todoMenosTabEnter>/^[^\t\n\x0B\f\r]+$/</todoMenosTabEnter>
    <enteros>/^-?[0-9]+$/</enteros>
    <todoMenosPtoComa>/^[^;]+$/</todoMenosPtoComa>
    <todo>/^[^]+$/</todo>
    <imagen>/^1.(jpg)|(PNP)|(png)|(JPG)|(gif)|(GIF)$/</imagen>
    <bandIconos>/^(accesos)|(inicios)$/</bandIconos>
    <entrada>/^(ultimo)|(nuevo)$/</entrada>
</expressions>
