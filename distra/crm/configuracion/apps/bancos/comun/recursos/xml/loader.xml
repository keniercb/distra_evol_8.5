                    cond='nombretasa|idtasaconversion|idcliente|nombretipotasa|desde|compra|venta|hasta|limit|offset'>
                HisTasa
            </nomenclador>
        </cargarlistasa>
        <cargarmonedacont>
            <nomenclador
                    consulta='select idmonedacontable,nom_moneda.codigoiso as moneda,nom_pais.codigopais as pais,descripcion,monaltern,dat_moneda.idpais,dat_moneda.idmoneda from mod_datosmaestros.dat_moneda inner join mod_datosmaestros.nom_moneda on mod_datosmaestros.dat_moneda.idmoneda = mod_datosmaestros.nom_moneda.idmoneda inner join mod_datosmaestros.nom_pais on mod_datosmaestros.dat_moneda.idpais =mod_datosmaestros.nom_pais.idpais'
                    cond='nom_moneda.codigoiso|nom_pais.codigopais|descripcion|limit|offset'>DatMoneda
            </nomenclador>
        </cargarmonedacont>
        <cargartasaconversion>
            <nomenclador
                    consulta='SELECT  dat_tasaconversion.idtasaconversion,dat_tasaconversion.idmonedacontable,dat_tasaconversion.idmoneda,dat_tasaconversion.nombre,dat_tasaconversion.precisiondeprecios,dat_tasaconversion.precisiondeimportes,nom_moneda.codigoiso AS moneda FROM mod_datosmaestros.dat_tasaconversion INNER JOIN mod_datosmaestros.nom_moneda ON (mod_datosmaestros.dat_tasaconversion.idmoneda = mod_datosmaestros.nom_moneda.idmoneda)'
                    cond='codigoiso|nombre|idmonedacontable|precisiondeprecios|precisiondeimportes|limit|offset'>
                DatTasaConversion
            </nomenclador>
        </cargartasaconversion>
        <cargarselect>
            <nomenclador consulta='select idmoneda,codigoiso from mod_datosmaestros.nom_moneda'>NomMoneda</nomenclador>
            <nomenclador consulta='select idpais,codigopais from mod_datosmaestros.nom_pais'>NomPais</nomenclador>
            <nomenclador
                    consulta='select idmonedacontable,codigoiso as descripcion from mod_datosmaestros.dat_moneda dm inner join mod_datosmaestros.nom_moneda nm on dm.idmoneda=nm.idmoneda'
                    cond='dm.monaltern|'>DatMoneda
            </nomenclador>
            <nomenclador consulta='select idtipotasa,nombretipotasa from mod_datosmaestros.nom_tipotasa'>NomTipotasa
            </nomenclador>
            <nomenclador
                    consulta='select codigo as idcliente,nombre as nombrecliente from mod_datosmaestros.nom_entidadpersona'>
                NomCliente
            </nomenclador>
            <nomenclador
                    consulta='select idtasa,venta,compra,idmonedacontable,desde,hasta,idcliente,referencia,idtipotasa,idmoneda,nom_tipotasa.nombretipotasa from mod_datosmaestros.dat_tasa INNER JOIN mod_datosmaestros.nom_tipotasa ON (mod_datosmaestros.dat_tasa.idtipotasa = mod_datosmaestros.nom_tipotasa.idtipotasa )'
                    cond='idtipotasa|limit|offset'>DatTasa
            </nomenclador>
            <nomenclador
                    consulta='SELECT  dat_tasaconversion.idtasaconversion,dat_tasaconversion.nombre FROM mod_datosmaestros.dat_tasaconversion'>
                DatTasaConversion
            </nomenclador>
            <nomenclador consulta='select idtasa,nombretasa from mod_datosmaestros.dat_tasa'>NombreTasa</nomenclador>
        </cargarselect>
