    <gestmultimoneda>
        <cargartasacamb>
            <nomenclador
                    consulta='SELECT dat_tasa.idtasa,dat_tasa.idtasaconversion,dat_tasa.factordeconversion,dat_tasa.venta,dat_tasa.compra,dat_tasa.cotizacionvariable,dat_tasa.desde,dat_tasa.hasta,dat_tasa.idcliente,dat_tasa.referencia,dat_tasa.idtipotasa,dat_tasa.nombretasa,nom_tipotasa.nombretipotasa FROM mod_datosmaestros.dat_tasa INNER JOIN mod_datosmaestros.nom_tipotasa ON (mod_datosmaestros.dat_tasa.idtipotasa = mod_datosmaestros.nom_tipotasa.idtipotasa)'
                    cond='nombretipotasa|idtasaconversion|idcliente|compra|venta|nombretasa|desde|hasta|limit|offset'>
                DatTasa
            </nomenclador>
        </cargartasacamb>
        <cargarlistasa>
            <nomenclador
