<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ReporteMaquinasEquiposMedios" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" >
    <property name="ireport.zoom" value="1.5"/>
    <property name="ireport.x" value="0"/>
    <property name="ireport.y" value="0"/>
    <parameter name="codigo_entidad" class="java.lang.String"/>
    <parameter name="nombre_entidad" class="java.lang.String"/>
    <queryString>
		<![CDATA[SELECT DISTINCT

							r.tasafiscal as tasa_depreciacion,
                            r.vidautil as vidautil,
                            r.nroinventario as nroinventario,
                            r.valoradquisicion as valor_inicial,
                            np.nombrepais as nacionalidad,
                            mm.denominacion as marca,
                            mmod.denominacion as modelo,
                            d.nrodoc as nro_movimiento,
                            i.denominacion as tipo_indicador,
                            rn.nroserie as nroserie,
 							r.fechaexpini as fecha_alta,
                            r.valoradquisicion as valor_inicial,
                            r.annofabricacion as fecha_fabricacion ,
                            rnt.nromotor1 as nromotor1,
                            rnt.nromotor2 as nromotor2,
                            rnt.nromatricula as chapa,
                            ntc.denominacion as tipo_combustible,
 (
                            SELECT cfgtipo.numchasis FROM mod_logactivofijotangible.conf_tipomedio cfgtipo
                            INNER JOIN mod_datosmaestros.nom_naturaleza nomnatura on cfgtipo.idtipomedio = nomnatura.idnaturaleza
                            WHERE nomnatura.idnaturaleza = i.idnaturaleza
                            )as es_transporte,
                            mvra.fechaadq as fecha_movimiento,
                            mvra.depreciacionacumulada as depreciacion_movimiento,
                            nop.denominacion as operacion_movimiento





                            from
                            mod_logactivofijotangible.dat_regnumericoactivo r
                            left join mod_logactivofijotangible.dat_regnumericoactivotransp rnt on
                            r.idregnumerico = rnt.idregnumerico
                            left join mod_logactivofijotangible.nom_tipocombustible ntc on
                            rnt.idtipocombustible = ntc.idtipocombustible
                            inner join mod_logactivofijotangible.dat_registronumerico rn on
                            rn.idregnumerico = r.idregnumerico
                            inner join mod_logistica.dat_movregnumerico mvr on mvr.idregnumerico = rn.idregnumerico
                            inner join mod_logactivofijotangible.dat_movregnumericoactivo mvra on 
                            mvr.idmovregnumerico = mvra.idmovregnumerico

                            inner join mod_logistica.dat_movimiento m on m.idmovimiento = mvr.idmovimiento

                            inner join  mod_logistica.dat_documento d on d.iddocumento = m.iddocumento

                            inner join mod_estructuracomp.dat_estructuraop eop on
                            d.idestructuracomun = eop.idestructuraop

                            inner join mod_logistica.dat_producto p on p.idproducto = rn.idproducto
                            inner join mod_datosmaestros.nom_indicador i on p.idindicador = i.idindicador
                            inner join  mod_datosmaestros.nom_indicadorhoja ih on ih.idindicador = i.idindicador
                            inner join  mod_datosmaestros.nom_gruposubgrupo gg on
                            ih.idgruposubgrupo = gg.idgruposubgrupo
                     INNER JOIN mod_datosmaestros.nom_operacion nop on d.idoperacion  = nop.idnomoperaciones
                    left join mod_datosmaestros.nom_naturaleza n on n.idnaturaleza = i.idnaturaleza
                    left join mod_datosmaestros.nom_marca mm on mm.idmarca = ih.idmarca
                   left join mod_logactivofijotangible.nom_color c on c.idcolor = r.idcolorsec
                    left join mod_datosmaestros.nom_modelo mmod on ih.idmodelo = mmod.idmodelo
                    left join mod_datosmaestros.nom_pais np on i.idpais = np.idpais
                    left join mod_logistica.dat_estructuraubicacion eu on r.idubicacion = eu.idestructuraubicacion

                   WHERE
                   r.idregnumerico = 1000092]]>
    </queryString>
