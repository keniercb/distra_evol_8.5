<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ReporteRegistrosAsociados" language="groovy" pageWidth="792" pageHeight="612" orientation="Landscape" columnWidth="752" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" >
    <property name="ireport.zoom" value="1.5"/>
    <property name="ireport.x" value="0"/>
    <property name="ireport.y" value="0"/>
    <queryString language="SQL">
		<![CDATA[select distinct
                    rn.idregnumerico,
					i.denominacion,
					modelo.denominacion as modelo,
					marca.denominacion as marca,
                    eu.descripcion as ubicacion,
                    rna.idarearesp,
                    rna.nroinventario,
                    rna.valoradquisicion,
                    rna.valorcontable,
                    rna.vidautil,
                    rna.tasafiscal,
                    rna.depreciacionacumulada,
                    rna.fechaadq,
                    rna.fechaexpini,
                    rna.fechaexpfin,
                    rna.esbaja,
                    rna.estaentidad,
                    rnat.nromatricula as matricula,
                    rnat.indicativo,
                    rnat.nrocirculacion as numcirculacion,
                    rnat.nromotor1 as numeromotor1,
                    rnat.nromotor2 as numeromotor2,
                    rnat.kilometraje,
                    rnat.indiceconsumo,
                    rnat.ficav,
                    rnat.lot,
                    rnat.capacidad as pax,
                    tipcom.denominacion as tipocombustible,
                    et.denominacion as estado,
                    es.denominacion as entidad,
                    deop.denominacion as arearesponsabilidad,
                    cat.denominacion as categoria,
                    cat.idcategoria as idcategoria,
                    rn.nroserie,
                    resp.idresponsable,
                    rn.idregnumerico,
					'yoendy' as responsable

from mod_logactivofijotangible.dat_regnumericoactivo rna
                  inner join mod_logactivofijotangible.dat_registronumerico rn on rn.idregnumerico = rna.idregnumerico
                  left join mod_logactivofijotangible.dat_regnumericoactivotransp rnat
                   on rn.idregnumerico = rnat.idregnumerico
                  left join mod_logactivofijotangible.nom_tipocombustible tipcom
                  on rnat.idtipocombustible = tipcom.idtipocombustible
                  left join mod_logactivofijotangible.nom_estatustecnico et
                  on rna.idestatustecnico = et.idestatustecnico
                  inner join mod_logistica.dat_producto p on p.idproducto = rn.idproducto
                  inner join mod_datosmaestros.nom_indicador i on p.idindicador = i.idindicador
                  inner join mod_logistica.dat_movimiento mv on p.idproducto = mv.idproducto
                  inner join mod_logistica.dat_documento doc on mv.iddocumento = doc.iddocumento
                  left join mod_logistica.nom_categoria cat on cat.idcategoria = rna.idcategoria
                  left join mod_logistica.dat_estructuraubicacion eu on rna.idubicacion = eu.idestructuraubicacion
                  inner join mod_estructuracomp.dat_estructuraop deop on deop.idestructuraop = rna.idarearesp
                  inner join mod_estructuracomp.nom_filaestruc f on f.idfila = deop.idestructuraop
                  inner join mod_estructuracomp.dat_estructura es on f.idpadre = es.idestructura
                  inner join mod_estructuracomp.nom_filaestruc fp on f.lft >= fp.lft and f.rgt <= fp.rgt
				  left join mod_logistica.dat_responsable resp on rna.idresponsable = resp.idresponsable

				  inner join mod_datosmaestros.nom_indicadorhoja ih on i.idindicador = ih.idindicador

				  left join mod_datosmaestros.nom_marca marca on ih.idmarca = marca.idmarca
                  left join mod_datosmaestros.nom_modelo modelo on ih.idmodelo = modelo.idmodelo

WHERE doc.estado = 3 AND p.idestructura IN (
                    SELECT idfila FROM mod_estructuracomp.nom_filaestruc
                        WHERE
                    lft >= (SELECT lft FROM mod_estructuracomp.nom_filaestruc WHERE idfila = 100000532) AND
                    rgt <= (SELECT rgt FROM mod_estructuracomp.nom_filaestruc WHERE idfila = 100000532)
                    ) AND i.idindicador = 596]]>
    </queryString>
    <field name="denominacion" class="java.lang.String"/>
    <field name="nroinventario" class="java.lang.String">
        <fieldDescription><![CDATA[Número de inventario.]]></fieldDescription>
    </field>
    <field name="nroserie" class="java.lang.String"/>
    <field name="valorcontable" class="java.math.BigDecimal">
        <fieldDescription><![CDATA[Valor contable.]]></fieldDescription>
    </field>
    <field name="vidautil" class="java.math.BigDecimal"/>
    <field name="tasafiscal" class="java.math.BigDecimal">
        <fieldDescription><![CDATA[Tasa fiscal del grupo.]]></fieldDescription>
    </field>
    <field name="depreciacionacumulada" class="java.math.BigDecimal">
        <fieldDescription><![CDATA[Depresiación acumulada.]]></fieldDescription>
    </field>
    <field name="estado" class="java.lang.String">
        <fieldDescription><![CDATA[Estado del estado financiero. 1 Configurado 2 Aprobado]]></fieldDescription>
    </field>
    <field name="arearesponsabilidad" class="java.lang.String"/>
    <field name="entidad" class="java.lang.String"/>
    <field name="responsable" class="java.lang.String"/>
    <background>
