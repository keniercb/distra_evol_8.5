    <parameter name="codigo_entidad" class="java.lang.String"/>
    <parameter name="nombre_entidad" class="java.lang.String"/>
    <queryString>
		<![CDATA[SELECT DISTINCT
ra.nroinventario as nroinventario,
gg.denominacion as descripcion,
ra.tasafiscal as tasa,
ra.vidautil as vidautil,
ra.fechaexpfin as fecha_alta,
ra.valoradquisicion as valor_inicial,

ra2.nroinventario as nroinventariohijo,
mm2.denominacion as marcahijo,
mmod2.denominacion as modelohijo,
i2.denominacion as tipo_componente_hijo,
r2.nroserie as serie_hijo,
ra2.valoradquisicion as valor_hijo



FROM mod_logactivofijotangible.dat_registronumerico r
INNER JOIN mod_logactivofijotangible.dat_regnumericoactivo ra on r.idregnumerico = ra.idregnumerico
INNER JOIN mod_logistica.dat_producto p on p.idproducto = r.idproducto
INNER JOIN mod_datosmaestros.nom_indicador i on p.idindicador = i.idindicador
INNER JOIN mod_datosmaestros.nom_indicadorhoja ih on ih.idindicador = i.idindicador
INNER JOIN mod_datosmaestros.nom_gruposubgrupo gg on ih.idgruposubgrupo = gg.idgruposubgrupo



LEFT JOIN mod_logactivofijotangible.dat_regnumericoactivo ra2 on (ra2.ordenizq > ra.ordenizq and ra2.ordender < ra.ordender)
LEFT JOIN mod_logactivofijotangible.dat_registronumerico r2 on ra2.idregnumerico = r2.idregnumerico
LEFT JOIN mod_logistica.dat_producto p2 on p2.idproducto = r2.idproducto
LEFT JOIN mod_datosmaestros.nom_indicador i2 on p2.idindicador = i2.idindicador
LEFT JOIN mod_datosmaestros.nom_indicadorhoja ih2 on ih2.idindicador = i2.idindicador
LEFT JOIN mod_datosmaestros.nom_marca mm2 on mm2.idmarca = ih2.idmarca
LEFT JOIN mod_datosmaestros.nom_modelo mmod2 on ih2.idmodelo = mmod2.idmodelo

WHERE r.idregnumerico = 1000069  and ra.esmodulo = 2]]>
    </queryString>
