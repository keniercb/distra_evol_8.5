    <queryString>
		<![CDATA[SELECT DISTINCT
ra.nroinventario as nroinventario,
gg.denominacion as descripcion,
ra.tasafiscal as tasa,
ra.vidautil as vidautil,
ra.fechaexpfin as fecha_alta,
ra.valoradquisicion as valor_inicial,

mvra.fechaadq as fecha_movimiento_padre,
d.nrodoc as nro_movimiento_padre,
nop.denominacion as detalle_movimiento_padre,
mvra.depreciacionacumulada dep_acumulada_movimiento_padre




FROM mod_logactivofijotangible.dat_registronumerico r
INNER JOIN mod_logactivofijotangible.dat_regnumericoactivo ra on r.idregnumerico = ra.idregnumerico
INNER JOIN mod_logistica.dat_producto p on p.idproducto = r.idproducto
INNER JOIN mod_datosmaestros.nom_indicador i on p.idindicador = i.idindicador
INNER JOIN mod_datosmaestros.nom_indicadorhoja ih on ih.idindicador = i.idindicador
INNER JOIN mod_datosmaestros.nom_gruposubgrupo gg on ih.idgruposubgrupo = gg.idgruposubgrupo

INNER JOIN mod_logistica.dat_movregnumerico mvr on mvr.idregnumerico = r.idregnumerico
INNER JOIN mod_logactivofijotangible.dat_movregnumericoactivo mvra on mvr.idmovregnumerico = mvra.idmovregnumerico
INNER JOIN mod_logistica.dat_movimiento m on m.idmovimiento = mvr.idmovimiento
INNER JOIN mod_logistica.dat_documento d on d.iddocumento = m.iddocumento
INNER JOIN mod_datosmaestros.nom_operacion nop on d.idoperacion  = nop.idnomoperaciones

WHERE r.idregnumerico = 1000069  and ra.esmodulo = 2]]>
    </queryString>
