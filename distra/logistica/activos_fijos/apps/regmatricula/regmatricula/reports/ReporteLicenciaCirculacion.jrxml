    <field name="colorsec" class="java.lang.String">
        <fieldDescription><![CDATA[Indentifica si el medio tiene color secundario o no. ]]></fieldDescription>
    </field>
    <field name="combustible" class="java.lang.String"/>
    <field name="fechaactual" class="java.lang.String"/>
    <field name="codigo" class="java.lang.String">
        <fieldDescription><![CDATA[Nombre del campo en donde se encuentra el codigo del nomenclador.]]></fieldDescription>
    </field>
    <field name="denominacion" class="java.lang.String"/>
    <field name="marca" class="java.lang.String"/>
    <field name="modelo" class="java.lang.String"/>
    <field name="denomestado" class="java.lang.String"/>
    <field name="nacionalidad" class="java.lang.String">
        <fieldDescription><![CDATA[Nacionalidad del país]]></fieldDescription>
    </field>
    <field name="registro" class="java.math.BigDecimal"/>
    <field name="tipo" class="java.math.BigDecimal">
        <fieldDescription><![CDATA[Tipo.]]></fieldDescription>
    </field>
    <field name="numerolaser1" class="java.lang.String"/>
    <field name="numerolaser2" class="java.lang.String"/>
    <field name="tonelage" class="java.math.BigDecimal"/>
    <field name="foliocirculacion" class="java.math.BigDecimal"/>
    <field name="denomtipotramite" class="java.lang.String"/>
    <field name="denomsector" class="java.lang.String"/>
    <field name="nombreinspector" class="java.lang.String"/>
    <background>
