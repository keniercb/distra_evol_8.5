		<variableExpression><![CDATA[$F{preciopub}]]></variableExpression>
	</variable>
	<variable name="sumaImpPrecioPubCuenta" class="java.lang.String" resetType="Group" resetGroup="CuentaGroup" calculation="Sum">
		<variableExpression><![CDATA[($F{preciopub}*$F{existencia}).toString().endsWith(".0")?($F{preciopub}*$F{existencia}) + "0":($F{preciopub}*$F{existencia})]]></variableExpression>
	</variable>
	<variable name="sumaSubTotalPagImpPPub" class="java.math.BigDecimal" resetType="Page" calculation="Sum">
