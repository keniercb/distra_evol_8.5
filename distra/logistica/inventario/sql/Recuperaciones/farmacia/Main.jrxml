	</variable>
	<variable name="sumaImporteCuenta" class="java.math.BigDecimal" resetType="Group" resetGroup="CuentaGroup" calculation="Sum">
		<variableExpression><![CDATA[$F{importetotalcup}]]></variableExpression>
	</variable>
	<variable name="sumaSubTotalNat" class="java.math.BigDecimal" resetType="Group" resetGroup="Group_naturaleza" calculation="Sum">
		<variableExpression><![CDATA[$F{importetotalcup}]]></variableExpression>
