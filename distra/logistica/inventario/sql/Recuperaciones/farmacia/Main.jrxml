	<variable name="sumaSubTotalPPub" class="java.math.BigDecimal" resetType="Group" resetGroup="Group_naturaleza" calculation="Sum">
		<variableExpression><![CDATA[$F{preciopub}]]></variableExpression>
	</variable>
	<variable name="sumaSubTotalImpPub" class="java.math.BigDecimal" resetType="Group" resetGroup="Group_naturaleza" calculation="Sum">
		<variableExpression><![CDATA[($F{preciopub}*$F{existencia}).toString().endsWith(".0")?($F{preciopub}*$F{existencia}) + "0":($F{preciopub}*$F{existencia})]]></variableExpression>
	</variable>
