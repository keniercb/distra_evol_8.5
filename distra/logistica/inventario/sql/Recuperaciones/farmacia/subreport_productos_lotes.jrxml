<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="subreport_productos_lotes" language="groovy" pageWidth="752" pageHeight="572" orientation="Landscape" columnWidth="752" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="93aa9590-fc74-46c1-9d29-d2642e529bae">
	<property name="ireport.zoom" value="1.771561000000001"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<property name="ireport.jasperserver.reportUnit" value="/reports/distra/logistica/farmacia/recuperaciones/SubmayorInventario"/>
	<property name="ireport.jasperserver.url" value="http://10.12.170.14:8081/jasperserver/services/repository"/>
	<parameter name="p_idproducto" class="java.math.BigDecimal">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="p_idindicador" class="java.math.BigDecimal">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select --lt.numero, lt.fechavencimiento, lt.existencia
	    dp.numerolote as numero, dp.fechavencelote as fechavencimiento,
	    dp.precio, round(dp.precio * dp.cantidad,2) as importecalculado,
	    dp.cantidad as existencia
        from mod_logistica.dat_producto dp
        --inner join mod_logistica.dat_lote lt on lt.idproducto = dp.idproducto
where dp.idindicador = $P{p_idindicador}
    and dp.cantidad > 0
	and dp.numerolote is not null
	and dp.fechavencelote is not null
	--and lt.existencia > 0
order by dp.numerolote]]>
	</queryString>
	<field name="numero" class="java.lang.String"/>
	<field name="fechavencimiento" class="java.sql.Date"/>
	<field name="precio" class="java.math.BigDecimal"/>
	<field name="importecalculado" class="java.math.BigDecimal"/>
	<field name="existencia" class="java.math.BigDecimal"/>
