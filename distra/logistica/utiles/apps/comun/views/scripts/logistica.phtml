<?php echo $this->doctype() ?>
<html lang="en" xml:lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
    <?php
    echo $this->headMeta();
    echo $this->headLink();
    ?>
</head>
<body>
<?php
if (is_array($this->uiVariables)) {
    echo '<script type="text/javascript">';
    foreach ($this->uiVariables as $var => $value) {
        echo "var {$var} = {$value};";
    }
    echo '</script>';
}


echo $this->headScript();
if (isset($this->arrayJs)) {
    foreach ($this->arrayJs as $js) {
        echo $js;
    }
}
if (isset($this->defaultJs)) {
    foreach ($this->defaultJs as $js) {
        echo $js;
    }
}
if(isset($this->mainViewJs)){
    echo "<script type=\"text/javascript\" src=\"{$this->mainViewJs}\"></script>";
}
?>
</body>
</html>