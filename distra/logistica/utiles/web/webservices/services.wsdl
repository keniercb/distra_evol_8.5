                           encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/>
            </output>
        </operation>
        <operation name="obtenerDatosMedioPorId">
            <soap:operation soapAction="urn:LogisticaSoapServicePortTypeAction"/>
            <input>
                <soap:body namespace="urn:LogisticaSoapService" use="encoded"
                           encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/>
            </input>
            <output>
                <soap:body namespace="urn:LogisticaSoapService" use="encoded"
                           encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/>
            </output>
        </operation>
        <operation name="obtenerNomencladorCategorias">
            <soap:operation soapAction="urn:LogisticaSoapServicePortTypeAction"/>
            <input>
                <soap:body namespace="urn:LogisticaSoapService" use="encoded" encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/>
            </input>
            <output>
                <soap:body namespace="urn:LogisticaSoapService" use="encoded" encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/>
            </output>
        </operation>
        <operation name="obtenerNaturalezas">
            <soap:operation soapAction="urn:LogisticaSoapServicePortTypeAction"/>
            <input>
                <soap:body namespace="urn:LogisticaSoapService" use="encoded" encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/>
            </input>
            <output>
                <soap:body namespace="urn:LogisticaSoapService" use="encoded" encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/>
            </output>
        </operation>
        <operation name="obtenerNomencladorDetalles">
            <soap:operation soapAction="urn:LogisticaSoapServicePortTypeAction"/>
            <input>
                <soap:body namespace="urn:LogisticaSoapService" use="encoded" encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/>
            </input>
            <output>
                <soap:body namespace="urn:LogisticaSoapService" use="encoded" encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/>
            </output>
        </operation>
        <operation name="obtenerNomencladorArbol">
            <soap:operation soapAction="urn:LogisticaSoapServicePortTypeAction"/>
            <input>
                <soap:body namespace="urn:LogisticaSoapService" use="encoded" encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/>
            </input>
            <output>
                <soap:body namespace="urn:LogisticaSoapService" use="encoded" encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/>
            </output>
        </operation>
        
        
        <operation name="obtenerMovRegNumerico">
            <soap:operation soapAction="urn:LogisticaSoapServicePortTypeAction"/>
            <input>
                <soap:body namespace="urn:LogisticaSoapService" use="encoded" encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/>
            </input>
            <output>
                <soap:body namespace="urn:LogisticaSoapService" use="encoded" encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/>
            </output>
        </operation>
        
        <operation name="obtenerRegNumDocumentos">
            <soap:operation soapAction="urn:LogisticaSoapServicePortTypeAction"/>
            <input>
                <soap:body namespace="urn:LogisticaSoapService" use="encoded" encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/>
            </input>
            <output>
                <soap:body namespace="urn:LogisticaSoapService" use="encoded" encodingStyle="http://schemas.xmlsoap.org/soap/encoding/"/>
            </output>
        </operation>
        
        
    </binding>
    <service name="LogisticaSoapServiceService">
        <port name="LogisticaSoapServicePort" binding="typens:LogisticaSoapServiceBinding">
            <soap:address location=""/>
        </port>
    </service>
</definitions>