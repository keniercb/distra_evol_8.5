    public function buscarOrdenIzqDer($idactividad) {
        $query = new Doctrine_Query();
        $result = $query->select(
                                'n.ordender as ordenderecho, n.ordenizq as ordenizquierdo,n.idarbol'
                        )->from('NomActividad n')->where('n.idactividad = ?', $idactividad)
                        ->setHydrationMode(Doctrine::HYDRATE_ARRAY)->execute();

        return $result;
    }

    //Utilizado como servicio
    public function obtenerActividadyNorma($nivel, $idactividad, $filtro, $start, $limit, $hijo
    ) {
        $cadenawhere = "";
        $cadenastartlimit = "";
        $consultotal = "SELECT COUNT (nom_actividad.denominacion)
  
FROM 
  mod_planificacion.nom_actividad";

        $connAux = Doctrine_Manager:: connection();

        $ress = $connAux->execute($consultotal);
        $total = $ress->fetchAll();
        /* Esto lo hago para saber el total que devuelve la consulta sin tener en cuenta el start y el limit */
        $cons = "SELECT
  count(nom_actividad.idactividad)
FROM 
  mod_planificacion.nom_actividad 
  
WHERE 
  nom_actividad.nivel = " . $nivel . " AND 
  nom_actividad.estado = 1 AND 
  nom_actividad.idaprobacion > 1 " . $cadenawhere;
        $paracontarcuantosdelmismotipo = $connAux->execute($cons);
        $totalporcondicion = $paracontarcuantosdelmismotipo->fetchAll();

        if ($start != 'null' && $limit != 'null') {
            $cadenastartlimit .= "OFFSET '$start' LIMIT $limit";
        }
        if ($idactividad != 'null' && is_array($idactividad)) {
            $array = implode(',', $idactividad);

            $cadenawhere .= "AND nom_actividad.idactividad  IN " . '(' . $array
                    . ')' . " ";
        } else {
            if ($idactividad != 'null' && !is_array($idactividad)) {
                $cadenawhere .= "AND nom_actividad.idactividad  ='$idactividad' ";
            }
        }

        if ($filtro != 'null') {
            foreach ($filtro as $key => $value) {
                if ($value['valor']) {
                    $cadenawhere .= " AND nom_actividad.denominacion ILIKE '%"
                            . $value['valor'] . "%'OR nom_actividad.codigo ILIKE '%"
                            . $value['valor'] . "%'";
                }
                if ($value['notIn']) {
                    $cadenawhere .= " AND nom_actividad.idactividad not in({$value['notIn']})";
                }
            }
        }


        $consulta = "SELECT
  *
FROM 
  mod_planificacion.nom_actividad 
  
WHERE 
  nom_actividad.nivel = " . $nivel . " AND 
  nom_actividad.estado = 1 AND 
  nom_actividad.idaprobacion > 1 " . $cadenawhere . $cadenastartlimit;

        $res = $connAux->execute($consulta);

        $result = $res->fetchAll();

        foreach ($result as $key => $value) {
            /* $result[$key]['arraynorma']  */ $coelga = self::obtenenormadadoid($value[0]);
            $resulnorma = self::limpiararreglo($coelga);
            $result[$key]['arraynorma'] = $resulnorma['norma'];
            $result[$key]['costo'] = $resulnorma['costo'];
            $result[$key]['tiempo'] = $resulnorma['tiempo'];
        }
        if ($hijo == 1 && $idactividad != 'null') {
            $result[$key]['arrayhijos'] = self::obtenerHijos($idactividad, $filtro);
        }
        $arreglo['datos'] = $result;
        $arreglo['total'] = $total[0][0];
        $arreglo['totalpaginado'] = $totalporcondicion[0][0];
        return $arreglo;
    }

    public function limpiararreglo($array) {
        $time = 0;
        $costo = 0;
        $norma = 0;
        foreach ($array as $valor) {
            if ($valor['naturaleza'] == 'Tiempo') {
                $time+=$valor['cantplanif'];
            } else {
                if ($valor['naturaleza'] == 'Costo de produccion') {
                    $costo+=$valor['cantplanif'];
                } else {
                    $respuesta['norma'][$norma] = $valor;
                    $norma++;
                }
            }
        }$respuesta['costo'] = $costo;
        $respuesta['tiempo'] = $time;
        return $respuesta;
    }

    public function obtenenormadadoid($idactividad) {

        $consulta = "SELECT
  dat_norma.idindicador,
  dat_norma.idactividad,
  dat_norma.cantbase,
  dat_norma.cantplanif,
  dat_norma.version,
  dat_norma.idnorma,
  dat_norma.idejercicio,
  nom_indicador.denominacion,
  nom_indicadorplanif.nivelplanif,
  nom_indicadorplanif.precio,nom_naturaleza.denominacion as naturaleza,
  nom_indicadorplanif.idaprobacion,
  nom_indicadorplanif.flete,
  nom_indicadorplanif.contingencia,
  nom_indicadorplanif.precioventa,
  nom_indicadorplanif.balanceable,
  nom_indicadorplanif.cobertura,
  nom_indicadorplanif.margencomercial,
  nom_indicadorplanif.preciodivisa,
  nom_indicadorplanif.seguro,
  nom_indicadorplanif.idindicador,
  nom_unidadmedida.idunidadmedida,
  nom_unidadmedida.denominacionunidadmedida,
  nom_unidadmedida.abreviaturaunidadmedida,
  nom_unidadmedida.descripcionunidadmedida,
  nom_unidadmedida.idmagnitud,
  nom_unidadmedida.fechainicio,
  nom_unidadmedida.fechafin,
  nom_unidadmedida.uriunidadmedida,
  nom_indicador.codigo
FROM
  mod_planificacion.dat_norma,
  mod_datosmaestros.nom_indicador,
  mod_datosmaestros.nom_indicadorplanif,
  mod_datosmaestros.nom_unidadmedida,
   mod_datosmaestros.nom_naturaleza
WHERE
  dat_norma.idindicador = nom_indicador.idindicador AND
  dat_norma.idindicador = nom_indicadorplanif.idindicador AND
  nom_indicador.idumedida = nom_unidadmedida.idunidadmedida AND
   nom_indicador.idnaturaleza = nom_naturaleza.idnaturaleza AND
  dat_norma.idactividad = '$idactividad'";
        $connAux = Doctrine_Manager:: connection();

        $res = $connAux->execute($consulta);
        $result = $res->fetchAll();

        return $result;
    }

    public function obtenerHijos($idactividad, $filtro) {
        $cadenawhere = '';
        if ($filtro != 'null') {
            foreach ($filtro as $key => $value) {
                /* if ($value['valor']) {
                  $cadenawhere .= " AND nom_actividad.denominacion ILIKE '%"
                  . $value['valor'] . "%'OR nom_actividad.codigo ILIKE '%"
                  . $value['valor'] . "%'";
                  } */
                if ($value['notIn']) {
                    $cadenawhere .= "and nom_actividad.idactividad not in({$value['notIn']})";
                }
            }
        }

        $consulta = "SELECT
  *
FROM
  mod_planificacion.nom_actividad

WHERE
  nom_actividad.idpadre = " . $idactividad . " $cadenawhere";

        $connAux = Doctrine_Manager:: connection();

        $res = $connAux->execute($consulta);
        $result = $res->fetchAll();
        foreach ($result as $key => $value) {

            $coelga = self::obtenenormadadoid($value[0]);
            $resulnorma = self::limpiararreglo($coelga);
            $result[$key]['arraynorma'] = $resulnorma['norma'];
            $result[$key]['costo'] = $resulnorma['costo'];
            $result[$key]['tiempo'] = $resulnorma['tiempo'];
            //   $result[$key]['arraynorma'] = self::obtenenormadadoid($value[0]);
        }
        return $result;
    }

    //Utilizado como servicio
    public function actualizarActividadesService($actividades, $configColumnas = array()
    ) {
        $result = array();
        $actividades = json_decode($actividades);
        foreach ($actividades as $actividad) {
            $obj = Doctrine::getTable('NomActividad')->find(
                    $actividad->idactividad
            );
            if ($obj) {
                foreach ($obj as $key => $value) {
                    $obj->$key = $actividad->$key;
                }
            } else {
                $actividad->id = $actividad->idinsactividad;
                array_push($result, $actividad);
            }
        }
        return $result;
    }

    //devuelve un arreglo de las actividades contenidas en el rango entrado por parametros
    public function BuscarHijos($idactividad, $comoarray = false) {
        //$idactividad
        /* temporal no traer a la LN los ids, hacerlo en una subconsulta */
        $ordenderordenizq = NomActividad::buscarOrdenIzqDer($idactividad);
        $query = new Doctrine_Query();
        if ($comoarray) {
            return $query->from('NomActividad a')->where(
                            'a.ordenizq>? AND a.ordender<? AND a.idpadre=?
                AND a.idactividad<>? AND a.idarbol = ?', array(
                        $ordenderordenizq[0]['ordenizquierdo'],
                        $ordenderordenizq[0]['ordenderecho'],
                        $idactividad,
                        $idactividad,
                        $ordenderordenizq[0]['idarbol'])
                    )->execute()->toArray();
        } else {
            return $query->from('NomActividad a')->where(
                            'a.ordenizq>? AND a.ordender<? AND a.idpadre=?
                AND a.idactividad<>? AND a.idarbol = ?', array(
                        $ordenderordenizq[0]['ordenizquierdo'],
                        $ordenderordenizq[0]['ordenderecho'],
                        $idactividad,
                        $idactividad,
                        $ordenderordenizq[0]['idarbol'])
                    )->execute();
        }
    }

    public function BuscarDecendiciaFamiliar($idactividad, $resultcomoarray = false
    ) {
        $ordenderordenizq = NomActividad::buscarOrdenIzqDer($idactividad);
        $query = new Doctrine_Query();
        $query->select('a.idactividad')->from('NomActividad a')->where(
                "a.ordender <= ? AND a.ordenizq >= ? AND a.idactividad <> ? AND a.idarbol = ?", array(
            $ordenderordenizq[0]['ordenderecho'],
            $ordenderordenizq[0]['ordenizquierdo'],
            $idactividad,
            $ordenderordenizq[0]['idarbol'])
        )->orderby('a.ordenizq  DESC');

        if ($resultcomoarray) {
            $result = $query->setHydrationMode(Doctrine::HYDRATE_ARRAY)
                    ->execute();
        } else {
            $result = $query->execute();
        }

        return $result;
    }

    public function BuscarDecendiciaFamiliarQueSonUltimonivel($idactividad, $ultimonivel, $sinindices = false
    ) {
        $ordenes = NomActividad::buscarOrdenIzqDer($idactividad);
        $query = new Doctrine_Query();
        $query->select('a.idactividad')->from('NomActividad a')->where(
                "a.nivel = $ultimonivel AND a.idarbol = " .
                $ordenes[0]['idarbol']
                . " AND a.idactividad <> $idactividad AND a.ordender <='" .
                $ordenes[0]['ordenderecho'] . "' AND a.ordenizq >='"
                . $ordenes[0]['ordenizquierdo'] .
                "' "
        )->orderby('a.ordenizq  DESC');
        if ($sinindices == true) {
            $resultAux = $query->execute()->toArray();
            $result = array();
            foreach ($resultAux as $act) {
                $result[] = $act['idactividad'];
            }
            return $result;
        } else {
            return $query->execute();
        }
    }

    public function buscarActividadesDelNivel($idactividad, $nivel) {
        //Buscar todas las actividades de la agrupacion cuyo nivel sea igual al ultimo
        return NomActividad::auxBuscarActividadesDecendientes(
                        $idactividad, $nivel
        );
    }

    private function auxBuscarActividadesDecendientes($idactividad, $ultimonivel
    ) {
        $actividadeshijas = NomActividad::BuscarHijos($idactividad);
        $actividades = array();
        foreach ($actividadeshijas as $actividadhija) {
            if ($actividadhija->nivel == $ultimonivel) {
                $actividades[] = $actividadhija->idactividad;
            } else {
                $actividades = array_merge(
                        $actividades, NomActividad::
                        auxBuscarActividadesDecendientes(
                                $actividadhija->idactividad, $ultimonivel
                        )
                );
            }
        }
        return $actividades;
    }

//nuevo
    public function listar($params) {

        $ejercicio = NomEjercicioplanificacion::listarEjercicioActual();
        $params['idejercicio'] = $ejercicio[0]['idejercicio'];
        $formatopredef = NomActividad::getFormatoandNivel();
        $arrayFormatoUltimonivel = (count($formatopredef) > 0) ? $formatopredef : array('0' => array('nivel' => 4));
        $iddatonomencladorcompartida = NomDatosnomenclador::getDatosNomPorUriDatosNom('compartida');
        $iddatonomencladordemandada = NomDatosnomenclador::getDatosNomPorUriDatosNom('demandada');
        $iddatonomencladorpropia = NomDatosnomenclador::getDatosNomPorUriDatosNom('propia');
        $devolverPadre = ($params['idpadre'] == 0 ? "null as _parent" : "idpadre as _parent");

        $addWhereFiltros = "";

        if ($params['filtros']) {
            foreach ($params['filtros'] as $datos) {
                if ($datos['field'] == 'codigo') {
                    $addWhereFiltros.=" AND a.codigo LIKE '" . $datos['data']['value'] . "%'";
                    if ($params['nivel'] == 1) {
                        $params['nivel'] = self::obtNivelPorCodigo($params['codesp'], $datos['data']['value']);
                    }
                } elseif ($datos['field'] == 'denominacion') {
                    $addWhereFiltros.=" AND upper(a.denominacion) LIKE  " . "'%" . mb_convert_case($datos['data']['value'], MB_CASE_UPPER, 'UTF-8') . "%'";
                } elseif ($datos['field'] == 'descripcion') {
                    $addWhereFiltros.=" AND upper(a.descripcion) LIKE  " . "'%" . mb_convert_case($datos['data']['value'], MB_CASE_UPPER, 'UTF-8') . "%'";
                } elseif ($datos['field'] == 'denespecialidad') {
                    $addWhereFiltros.=" AND a.idespecialidad  =  {$datos['data']['value']}";
                } elseif ($datos['field'] == 'estado') {
                    if ($datos['data']['value'] == 'Si') {
                        $addWhereFiltros.=" AND a.estado  =  1";
                    }
                    if ($datos['data']['value'] == 'No') {
                        $addWhereFiltros.=" AND a.estado  =  0";
                    }
                } elseif ($datos['field'] == 'normada') {
                    if ($datos['data']['value'] == 'Si') {
                        $addWhereFiltros.=" AND coalesce(n.idactividad,0) != 0";
                    } else {
                        $addWhereFiltros.=" AND coalesce(n.idactividad,0) = 0";
                    }
                } elseif ($datos['field'] == 'reglas') {
                    $temp = "coalesce((
                            select count(dr.idregla)
                            from mod_planificacion.dat_regla dr
                            LEFT JOIN mod_planificacion.dat_norma dn ON (dn.idnorma =
                            dr.idnorma and dr.idejercicio = {$params['idejercicio']})
                            Where dn.idactividad = a.idactividad), 0)";
                    if ($datos['data']['value'] == 'Si') {
                        $addWhereFiltros.=" AND $temp > 0";
                    } else {
                        $addWhereFiltros.=" AND $temp = 0";
                    }
                } elseif ($datos['field'] == 'compartida') {
                    if ($datos['data']['value'] == 'Si') {
                        $addWhereFiltros.=" AND coalesce(ac.idactividad,0) != 0";
                    } else {
                        $addWhereFiltros.=" AND coalesce(ac.idactividad,0) = 0";
                    }
                } elseif ($datos['field'] == 'demandadas') {
                    if ($datos['data']['value'] == 'Si') {
                        $addWhereFiltros.=" AND coalesce(ac2.idactividad,0) != 0";
                    } else {
                        $addWhereFiltros.=" AND coalesce(ac2.idactividad,0) = 0";
                    }
                } elseif ($datos['field'] == 'idaprobacion') {
                    if ($datos['data']['value'] == 'Si' || $datos['data']['value'] == 'Sí') {
                        $addWhereFiltros.=" AND a.idaprobacion  = 3";
                    } else {
                        if ($datos['data']['value'] == 'Rector') {
                            $addWhereFiltros.=" AND a.idaprobacion  = 4";
                        } else {
                            $addWhereFiltros.=" AND a.idaprobacion  = 1";
                        }
                    }
                } elseif ($datos['field'] == 'denmodelo') {
                    if ($datos['data']['value'] == '-') {
                        $addWhereFiltros.=" AND am.idmodelo is null";
                    } else {
                        $addWhereFiltros.=" AND am.idmodelo ={$datos['data']['value']}";
                    }
                }
            }
        }

        if ($params['nivel'] != null && $params['nivel'] != '' && $params['idpadre'] == null) {
            $whereNivel = " AND a.nivel ={$params['nivel']}";
        } elseif ($params['idpadre']) {
            $whereIdpadre = " AND a.idpadre ={$params['idpadre']} AND a.idpadre <> a.idactividad";
        }

        //filtrar actividades con un indicador especifico en sus normas
        if ($params['idindicadorebuscar'] != null && $params['limpiarbuscar'] != 2) {
            $conn = Doctrine_Manager::connection();
            $sqlQuery = "SELECT  distinct n.idactividad
      FROM mod_planificacion.dat_norma  n
      WHERE n.idindicador = " . $params['idindicadorebuscar'] . "";

            if ($params['idejerciciosbuscar'] != null) {
                $sqlQuery .= " AND n.idejercicio in({$params['idejerciciosbuscar']})";
            }
            $idactividadfiltro = $conn->execute($sqlQuery)->fetchAll(PDO::FETCH_ASSOC);

            foreach ($idactividadfiltro as $key => $value) {
                $idactividadfiltro[$key] = $value['idactividad'];
            }
            if ($idactividadfiltro[0] == null) {
                $idactividadfiltro[0] = 0;
            }
            $idact = implode(',', $idactividadfiltro);
            $whereIdActNorm = " AND a.idactividad in($idact)";
        }

        if ($params['esrector'] != 'ok') {
            $esp = implode(',', $params['ids_especialidad_subespecialidades']);
            $whereIdActEsp = " AND a.idespecialidad in($esp)";
        }
        $conn = Doctrine_Manager::connection();
        $query = "SELECT a.idactividad,
      count(*) OVER() as total,
      coalesce((
      select count(dr.idregla)
      from mod_planificacion.dat_regla dr
      LEFT JOIN mod_planificacion.dat_norma dn ON (dn.idnorma =
      dr.idnorma and dr.idejercicio = {$params['idejercicio']})
      Where dn.idactividad = a.idactividad
      ), 0) as reglas,
      coalesce((
      select count(ar.idregla)
      from mod_planificacion.dat_actividadregla ar
      LEFT JOIN mod_planificacion.dat_regla reg ON (ar.idregla
      = reg.idregla AND reg.idejercicio = {$params['idejercicio']})
      WHERE ar.idactividad = a.idactividad
      ), 0) as reglasactiv,
      coalesce(ac.idactividad, 0) as compartida,
      coalesce(ac2.idactividad, 0) as demandadas,
      a.idpadre,
      a.codigo,
      a.idformato,
      a.idespecialidad,
      a.idespecialidadrector,
      a.denominacion,
      a.estado,
      a.idaprobacion,
      a.idarbol,
      a.descripcion,
      a.nivel,
      a.ordender,
      a.ordenizq,
      coalesce(n.idactividad, 0) as normada,
      am.idmodelo as idmodelo,
      ams.idmodelo as idmodelosalida,
      coalesce(mod.denominacion, '-') as denmodelo,
      $devolverPadre,
      ((a.ordender - a.ordenizq) = 1) as _is_leaf
      FROM mod_planificacion.nom_actividad a
      LEFT JOIN mod_planificacion.dat_actividadmodelo am ON am.idactividad =
      a.idactividad
      LEFT JOIN mod_planificacion.dat_actividadmodelosalida ams ON
      ams.idactividad = a.idactividad
      LEFT JOIN mod_planificacion.dat_modelo mod ON am.idmodelo = mod.idmodelo
      LEFT JOIN mod_planificacion.dat_norma n ON (a.idactividad = n.idactividad
      and n.idejercicio = {$params['idejercicio']})
      LEFT JOIN mod_planificacion.dat_regla r ON (n.idnorma = r.idnorma and
      r.idejercicio = {$params['idejercicio']})
      LEFT JOIN mod_planificacion.dat_actespcomportamiento ac ON (a.idactividad =
      ac.idactividad and ac.iddatosnomenclador =
      {$iddatonomencladorcompartida[0]['iddatosnomenclador']})
      LEFT JOIN mod_planificacion.dat_actespcomportamiento ac2 ON (a.idactividad
      = ac2.idactividad and ac2.iddatosnomenclador =
      {$iddatonomencladordemandada[0]['iddatosnomenclador']})
      where true
      $whereNivel
      $whereIdpadre
      $whereIdActNorm
      $whereIdActEsp
      $addWhereFiltros
      group by 
      a.idactividad,
      ac.idactividad,
      ac2.idactividad,
      n.idactividad,
      am.idmodelo,
      ams.idmodelo,
      mod.denominacion
      ORDER BY a.codigo
      OFFSET {$params['start']}
      LIMIT {$params['limit']}";
        $data->data = $conn->execute($query)->fetchAll(PDO::FETCH_ASSOC);
        $data->total = $data->data[0]['total'];

        $arrayDenEspecialidaddes = array();
        $arrayDatosFormato = array();

        //usado por el exportar actividad
        $arrayIdsactividades = array();

        foreach ($data->data as $indice => $valor) {
            if ($valor['normada'] != 0) {
                $data->data[$indice]['normada'] = 1;
            }
            if ($valor['reglas'] != 0 || $valor['reglasactiv'] != 0) {
                $data->data[$indice]['reglas'] = 1;
            }
            if ($valor['compartida'] != 0) {
                $data->data[$indice]['compartida'] = 1;
            }
            if ($valor['demandadas'] != 0) {
                $data->data[$indice]['demandadas'] = 1;
            }
            if ($params['addarrayidsact'] == true) {
                $arrayIdsactividades[] = $valor['idactividad'];
            }
            $data->data[$indice]['esultimonivel'] = ($valor['nivel'] == $arrayFormatoUltimonivel[0]['nivel']) ? true : false;
            if ($arrayDenEspecialidaddes["cod_" . $valor['idespecialidad']] == null) {
                $integrator = ZendExt_IoC::getInstance();
                $especialidades = $integrator->datosmaestros->obtenerEspecialidadPorId($valor['idespecialidad']);
                $arrayDenEspecialidaddes["den_" . $valor['idespecialidad']] = $especialidades[0]->denespecialidad;
                $arrayDenEspecialidaddes["cod_" . $valor['idespecialidad']] = $especialidades[0]->codespecialidad;
            }
            $data->data[$indice]['denespecialidad'] = $arrayDenEspecialidaddes["den_" . $valor['idespecialidad']];
            $data->data[$indice]['codespecialidad'] = $arrayDenEspecialidaddes["cod_" . $valor['idespecialidad']];

            $data->data[$indice]['codigopadre'] = ($data->data[$indice]['idactividad'] != $data->data[$indice]['idpadre']) ? (NomActividad::obtenerCodigoPadre($data->data[$indice]['idpadre'])) : $data->data[$indice]['codespecialidad'];
            $data->data[$indice]['importe'] = number_format('0', '6', '.', ',');

            if ($arrayDatosFormato['idformato_' . $valor['idformato']] == null) {
                $partesformato = $params['integrator']->datosmaestros->buscarParteFormato($valor['idformato']);
                foreach ($partesformato as $parte) {
                    if ($parte->nivel == $valor['nivel']) {
                        $arrayDatosFormato['idformato_' . $valor['idformato']]['nombredelnivel'] = $parte->nombre;
                        $arrayDatosFormato['idformato_' . $valor['idformato']]['abreviaturadelnivel'] = $parte->abreviatura;
                    }
                }
            }
            $data->data[$indice]['nombredelnivel'] = $arrayDatosFormato['idformato_' . $valor['idformato']]['nombredelnivel'];
            $data->data[$indice]['abreviaturadelnivel'] = $arrayDatosFormato['idformato_' . $valor['idformato']]['abreviaturadelnivel'];

//trabajo con los comportamientos
            $conn = Doctrine_Manager::connection();
            $sqlQuery = "SELECT distinct CASE
                  WHEN aec.iddatosnomenclador = {$iddatonomencladordemandada[0]['iddatosnomenclador']} then 0
                  WHEN aec.iddatosnomenclador = {$iddatonomencladorcompartida[0]['iddatosnomenclador']} then 1
                  END as tipo,
       aec.idespecialidad
FROM mod_planificacion.dat_actespcomportamiento aec
WHERE aec.idactividad = {$valor['idactividad']} AND aec.iddatosnomenclador <> {$iddatonomencladorpropia[0]['iddatosnomenclador']}";
            $data->data[$indice]['comportamientos'] = $conn->execute($sqlQuery)->fetchAll(PDO::FETCH_ASSOC);
            $data->data[$indice]['DatActespcomportamiento'] = $data->data[$indice]['comportamientos'];
        }
        if ($params['addarrayidsact'] == true) {
            $data->arrayIdsactividades = $arrayIdsactividades;
        }

        return $data;
    }

