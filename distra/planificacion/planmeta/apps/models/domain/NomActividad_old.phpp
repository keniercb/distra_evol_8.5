    public function obtNivelPorCodigo($codesp, $codact) {
        $arrayIntervs = self::obtIntervalosPorPartesDeFormatos($codesp);
        $longcod = strlen($codact);
        foreach ($arrayIntervs as $kNivel => $rango) {
            if ($longcod >= $rango[0] && $longcod <= $rango[1]) {
                return $kNivel;
            }
        }
        return 1;
    }

    /*     * *** Funcion para calcular el importe total de una actividad o
      grupo de actividades  **** */

    public function importeTotal($idactividad) {
        $decendecia = NomActividad::BuscarDecendiciaFamiliar($idactividad);
        $importeTotal = 0;

        if ($decendecia[0]->idactividad != null) {
            foreach ($decendecia as $actividad) {
                $importeTotal += DatNorma::calcularImporte(
                                $actividad->idactividad
                );
            }
        } else {
            $importeTotal = DatNorma::calcularImporte($idactividad);
        }
        return $importeTotal;
    }

    /*     * *** Fin de la funcion para calcular el importe total
      de una actividad o grupo de actividades  **** */

    public function existeCodigo($codigo) {
        $query = Doctrine_Query::create();
        $result = (($query->select('COUNT(a.idactividad) as total')->from(
                        'NomActividad a'
                )->where(" a.codigo = ?", $codigo)->execute()->getFirst()->total) > 0);

        return $result;
    }

    public function existeCodigoAlModificar($idactividad, $codigo) {

        $query = Doctrine_Query::create();
        $result = $query->from('NomActividad')->where(
                        "idactividad <> ? AND codigo = ?", array($idactividad, $codigo)
                )->execute()->getFirst();
        if ($result->codigo == $codigo) {
            return true;
        }
        return false;
    }

    public function formato($integrator, $denoFormato = 'Actividades') {
        /* //temporal solicitar un servicio que dado una denominacion
          $formato = $integrator->datosmaestros->listarFormatos(); //asdasdasdasd
          foreach ($formato as $valor) {
          if ($valor->nombre == $denoFormato) {
          $idformatoAct = $valor->idformato;
          }
          } */
        $select = " SELECT f.idformato FROM mod_planificacion.nom_formatopredefinido f";
        $conex = Doctrine_Manager:: connection();
        $result = $conex->execute($select)->fetchAll(PDO::FETCH_COLUMN);
        return $result[0];
    }

