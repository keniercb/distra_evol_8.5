            </prototipo>
        </obtenerPermisosPostCondiciones>
        <obtenerPermisosPostAccion reference="workflow">
            <inyector clase="WorkflowServices" metodo="obtenerPermisosPostAccion" />
            <prototipo>
                <parametro nombre="idusuario" tipo="enterospos" />
                <parametro nombre="idestado" tipo="enterospos" />
                <parametro nombre="idtipodoc" tipo="enterospos" />
                <resultado tipo="array" />
            </prototipo>
        </obtenerPermisosPostAccion>
 </workflow>
</ioc>