#!/bin/sh -e

### BEGIN INIT INFO
# Provides:          zeolides_amqp_consumer_task
# Required-Start:    rabbitmq-server
# Required-Stop:     rabbitmq-server
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
### END INIT INFO

DAEMON_PATH="/opt/stack-xetid-mt/apps/DISTRA/zeolides/lib/Amqp/Worker"
DAEMON_NAME="consumer_task.sh"
DAEMON=$DAEMON_PATH/$DAEMON_NAME
NAME=`basename "$0"`
PIDFILE="/var/run/zeolides_amqp_consumer_task.pid"

start(){
	echo "Info: Iniciando el servicio de ejecución de tareas de Zeolides..."
	#AQUI se inicia el servicio
	start-stop-daemon -S -m -b -p $PIDFILE -a $DAEMON -x $DAEMON
    echo "Info: El servicio de ejecución de tareas de Zeolides ha sido iniciado."
}

stop(){
	echo "Info: Deteniendo el servicio de ejecución de tareas de Zeolides..."
	start-stop-daemon -K -m -p $PIDFILE --oknodo -x $DAEMON
    rm $PIDFILE
    echo "Info: El servicio de ejecución de tareas de Zeolides ha sido detenido."
}

reload(){
	stop
	start
}

status(){
	echo "Info: Verificando estado..."
	if [ -e $PIDFILE ]; then
		PID=$(cat $PIDFILE)
		if [ -e /proc/${PID} -a /proc/${PID}/exe ]; then
			echo "Info: El servicio de ejecución de tareas de Zeolides está corriendo."
		else
			echo "Info: El servicio de ejecución de tareas de Zeolides no está corriendo."   
		fi
	else
		echo "Info: El servicio de ejecución de tareas de Zeolides no está corriendo."
	fi
}


case "$1" in
start)
	start
	;;

stop)
	stop
	;;

restart)
	reload
	;;

status)
	status
	;;
*)
	echo "Uso: Utilice una de las opciones {start|stop|restart|status}"
	exit 1
	;;
esac
exit 0

