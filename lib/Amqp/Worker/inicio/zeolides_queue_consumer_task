#!/bin/sh -e

### BEGIN INIT INFO
# Provides:          zeolides_queue_consumer_task
# Required-Start:    rabbitmq-server
# Required-Stop:     rabbitmq-server
# Default-Start:     2 3 4 5
# Default-Stop:      0 1 6
### END INIT INFO

DAEMON=/var/www/html/Zeolides/mio/zeolides/lib/Amqp/Worker/consumer_queue.sh
NAME=zeolides_queue_consumer_task
PIDFILE="/var/run/zeolides_queue_consumer_task.pid"

start(){
	echo "Info: Iniciando la cola de notificaiones de Zeolides..."
	#AQUI se inicia el servicio
	start-stop-daemon -S -m -b -p $PIDFILE -a $DAEMON -x $DAEMON
    echo "Info: La cola de notificaciones de Zeolides ha sido iniciada."
}

stop(){
	echo "Info: Deteniendo la cola de notificaciones de Zeolides..."
	start-stop-daemon -K -m -p $PIDFILE --oknodo -x $DAEMON
    rm $PIDFILE
    echo "Info: La cola de notificaciones de Zeolides ha sido detenido."
}

reload(){
	stop
	start
}

status(){
	echo "Info: Verificando estado..."
	if [ -e $PIDFILE ]; then
		PID=$(cat $PIDFILE)
		if [ -e /proc/${PID} -a /proc/${PID}/exe ]; then
			echo "Info: La cola de notificaciones de Zeolides está corriendo."
		else
			echo "Info: La cola de notificaciones de Zeolides no está corriendo."
		fi
	else
		echo "Info: La cola de notificaciones de Zeolides no está corriendo."
	fi
}


case "$1" in
start)
	start
	;;

stop)
	stop
	;;

restart)
	reload
	;;

status)
	status
	;;
*)
	echo "Uso: Utilice una de las opciones {start|stop|restart|status}"
	exit 1
	;;
esac
exit 0