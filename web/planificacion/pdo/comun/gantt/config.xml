	<event_markers>
		<groups>
			<group chart="idCumulativeTotalsChart" series="idSeriesIssuesCreated">
				<settings>
					<shape type="Rect">
						<corners all="3"/>
					</shape>
					<font color="#000000"/>
					<tooltip enabled="true">
						<background>
							<fill type="Gradient">
								<gradient angle="90">
									<keys>
										<key color="#FEFEFE"/>
										<key color="#F1F1F1"/>
									</keys>
								</gradient>
							</fill>
							<border color="#BDBDBD"/>
						</background>
						<font color="#333333" bold="true" size="10"/>
					</tooltip>
				</settings>
				<locale>
					<date_time>
						<format><![CDATA[%d-%MMMM-%yyyy]]></format>
					</date_time>
				</locale>
				<events>
					<event locale_based_date="20-July-2009" format="O">
						<settings>
							<tooltip>
								<format><![CDATA[Reorganization of dev. team]]></format>
							</tooltip>
						</settings>
					</event>
					<event locale_based_date="19-December-2009" format="T">
						<settings>
							<tooltip>
								<format><![CDATA[The beginning of the testing phase.]]></format>
							</tooltip>
						</settings>
					</event>
					<event locale_based_date="4-February-2010" format="F">
						<settings>
							<tooltip>
								<format><![CDATA[Code freeze.]]></format>
							</tooltip>
						</settings>
					</event>
					<event locale_based_date="14-March-2010" format="R">
						<settings>
							<tooltip>
								<format><![CDATA[The beginning of the release phase.]]></format>
							</tooltip>
						</settings>
					</event>
				</events>
			</group>
		</groups>
	</event_markers>
